# API Studio (le back-end de contenu). Adresse du serveur, sans /api/v1.
# En production : https://api.matteo-bonneval.fr
NUXT_STUDIO_API_URL=http://localhost:8080
# Slug du site de ce portfolio dans l'API
NUXT_STUDIO_SITE=portfolio

# Turnstile : seule la clé publique sert ici. La vérification du jeton est faite par l'API.
NUXT_TURNSTILE_SITE_KEY=

NUXT_OG_IMAGE_SECRET=
NUXT_PUBLIC_SITE_URL=
