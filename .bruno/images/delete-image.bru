meta {
  name: Delete image
  type: http
  seq: 3
}

delete {
  url: {{base_url}}/images/:id
  body: none
  auth: inherit
}

params:path {
  id: {{image_id}}
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("success est true", function() {
    expect(res.body.success).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}