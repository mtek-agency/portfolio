meta {
  name: Upload images
  type: http
  seq: 1
}

post {
  url: {{base_url}}/projects/:slug/images
  body: multipartForm
  auth: inherit
}

params:path {
  slug: {{slug}}
}

body:multipart-form {
  images: @file(./.fixtures/test.jpg) @contentType(File)
}

script:post-response {
  if (res.status === 200 && res.body.results && res.body.results.length > 0) {
    bru.setEnvVar("image_id", res.body.results[0].id);
    bru.setEnvVar("image_path", res.body.results[0].filename);
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("success est true", function() {
    expect(res.body.success).to.equal(true);
  });
  test("results est un tableau non vide", function() {
    expect(res.body.results).to.be.an("array");
    expect(res.body.results.length).to.be.greaterThan(0);
  });
  test("Image a un id et une url", function() {
    const img = res.body.results[0];
    expect(img).to.have.property("id");
    expect(img).to.have.property("url");
    expect(img).to.have.property("filename");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}