meta {
  name: Record post view (public)
  type: http
  seq: 10
}

post {
  url: {{base_url}}/blog/:slug/view
  body: none
  auth: none
}

params:path {
  slug: {{post_slug}}
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Réponse contient ok: true", function() {
    expect(res.body.ok).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
