meta {
  name: Get post views count
  type: http
  seq: 12
}

get {
  url: {{base_url}}/posts/:slug/views
  body: none
  auth: inherit
}

params:path {
  slug: {{post_slug}}
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Réponse contient views (number)", function() {
    expect(res.body).to.have.property("views");
    expect(res.body.views).to.be.a("number");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
