meta {
  name: Get all posts (admin)
  type: http
  seq: 1
}

get {
  url: {{base_url}}/posts
  body: none
  auth: inherit
}

script:post-response {
  if (res.status === 200 && res.body.length > 0) {
    bru.setEnvVar("post_slug", res.body[0].slug);
    bru.setEnvVar("post_id", res.body[0].id);
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Réponse est un tableau", function() {
    expect(res.body).to.be.an("array");
  });
  test("Chaque article a un slug et un statut", function() {
    if (res.body.length > 0) {
      expect(res.body[0]).to.have.property("slug");
      expect(res.body[0]).to.have.property("status");
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
