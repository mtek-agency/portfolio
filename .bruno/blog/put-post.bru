meta {
  name: Update post
  type: http
  seq: 4
}

put {
  url: {{base_url}}/posts/:slug
  body: json
  auth: inherit
}

params:path {
  slug: {{post_slug}}
}

body:json {
  {
    "title": "Mon premier article (mis à jour)",
    "slug": "mon-premier-article",
    "excerpt": "Un résumé de l'article.",
    "content": "<p>Contenu de l'article.</p>",
    "coverImage": null,
    "tags": "nuxt,vue",
    "status": "draft",
    "isFeatured": false
  }
}

script:post-response {
  if (res.status === 200 && res.body.slug) {
    bru.setEnvVar("post_slug", res.body.slug);
  }
}

tests {
  test("Article mis à jour - status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("updatedAt est présent", function() {
    expect(res.body).to.have.property("updatedAt");
  });
  test("isFeatured est un boolean", function() {
    expect(res.body.isFeatured).to.be.a("boolean");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
