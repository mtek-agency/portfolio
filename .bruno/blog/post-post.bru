meta {
  name: Create post
  type: http
  seq: 2
}

post {
  url: {{base_url}}/posts
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Mon premier article",
    "slug": "mon-premier-article"
  }
}

script:post-response {
  if (res.status === 200 && res.body.slug) {
    bru.setEnvVar("post_slug", res.body.slug);
    bru.setEnvVar("post_id", res.body.id);
  }
}

tests {
  test("Article créé - status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Réponse contient l'id", function() {
    expect(res.body).to.have.property("id");
  });
  test("Slug correspond", function() {
    expect(res.body.slug).to.equal("mon-premier-article");
  });
  test("Statut est draft par défaut", function() {
    expect(res.body.status).to.equal("draft");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
