meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("slug", bru.getEnvVar("slug") || "portfolio");
  }
}

tests {
  test("Login réussi - status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Réponse contient un user", function() {
    expect(res.body).to.have.property("user");
  });
  test("Password absent de la réponse", function() {
    expect(res.body.user).to.not.have.property("password");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
