meta {
  name: Send contact email
  type: http
  seq: 4
}

post {
  url: {{base_url}}/contact
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Mattéo",
    "email": "matteo@example.com",
    "message": "Bonjour, je souhaite vous contacter au sujet d'un projet.",
    "newsletter": true,
    "token": "1x0000000000000000000000000000000AA"
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("success est true", function() {
    expect(res.body.success).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}