meta {
  name: Get project
  type: http
  seq: 4
}

get {
  url: {{base_url}}/projects/:slug
  body: none
  auth: inherit
}

params:path {
  slug: {{slug}}
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Projet contient slug, name, description", function() {
    expect(res.body).to.have.property("slug");
    expect(res.body).to.have.property("name");
    expect(res.body).to.have.property("description");
  });
  test("Projet contient un tableau images", function() {
    expect(res.body).to.have.property("images");
    expect(res.body.images).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
