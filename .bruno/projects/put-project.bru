meta {
  name: Update project
  type: http
  seq: 5
}

put {
  url: {{base_url}}/projects/:slug
  body: json
  auth: inherit
}

params:path {
  slug: {{slug}}
}

body:json {
  {
    "name": "Portfolio V5 (mis à jour)",
    "description": "Mon portfolio personnel construit avec Nuxt 3 et Nuxt UI.",
    "year": "2026",
    "slug": "portfolio-v5",
    "urlWebsite": "https://matteo-bonneval.fr",
    "urlRepository": "https://github.com/matteo-bonneval/portfolio",
    "tags": "nuxt,vue,typescript",
    "stack": "Nuxt 3,Nuxt UI,NuxtHub,Drizzle ORM,PostgreSQL",
    "isDisabled": false
  }
}

script:post-response {
  if (res.status === 200 && res.body.slug) {
    bru.setEnvVar("slug", res.body.slug);
  }
}

tests {
  test("Projet mis à jour - status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("updatedAt est présent", function() {
    expect(res.body).to.have.property("updatedAt");
  });
  test("isDisabled est un boolean", function() {
    expect(res.body.isDisabled).to.be.a("boolean");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}