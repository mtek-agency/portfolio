meta {
  name: Record project view
  type: http
  seq: 7
}

post {
  url: {{base_url}}/projects/:slug/view
  body: none
  auth: none
}

params:path {
  slug: {{slug}}
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Réponse ok", function() {
    expect(res.body.ok).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
