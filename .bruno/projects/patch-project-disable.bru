meta {
  name: Toggle project disabled
  type: http
  seq: 6
}

patch {
  url: {{base_url}}/projects/:slug/disable
  body: json
  auth: inherit
}

params:path {
  slug: {{slug}}
}

body:json {
  {
    "isDisabled": true
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("isDisabled est true", function() {
    expect(res.body.isDisabled).to.equal(true);
  });
  test("updatedAt est présent", function() {
    expect(res.body).to.have.property("updatedAt");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}