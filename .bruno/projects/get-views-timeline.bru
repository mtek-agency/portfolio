meta {
  name: Get views timeline
  type: http
  seq: 8
}

get {
  url: {{base_url}}/projects/views/timeline
  body: none
  auth: inherit
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Réponse est un tableau de 12 mois", function() {
    expect(res.body).to.be.an("array");
    expect(res.body.length).to.equal(12);
  });
  test("Chaque point a month et views", function() {
    const point = res.body[0];
    expect(point).to.have.property("month");
    expect(point).to.have.property("views");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
